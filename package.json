{
    "name":  "dsh-auto-continue",
    "description":  "Auto-continue interrupted sessions: probe an available fallback model, switch durably, and resume",
    "version":  "1.2.0",
    "private":  true,
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "test/",
                  "README.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-settings",
                                              "@deepseek-ai/dsh-client-ui-plugin-manager"
                                          ]
                           }
            },
    "dependencies":  {
                         "@deepseek-ai/dsh-llm":  "0.2.2-rc.1",
                         "@deepseek-ai/schemastery":  "~3.19.0"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "~4.1.0",
                             "@deepseek-ai/dsh-llm":  "0.2.2-rc.1",
                             "@deepseek-ai/schemastery":  "~3.19.0"
                         }
}